{
  "name": "levi",
  "version": "0.4.0",
  "description": "Levi — minimal Claude Code plugin shell. Same axes as Reuben, zero items inside. Add modes, agents, hooks, and reporters one at a time.",
  "author": {
    "name": "Levi",
    "url": "https://github.com/VoteWood/Levi"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guards/tool-context-loader.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
